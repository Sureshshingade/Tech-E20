# Copy these values into your Windows environment or a local .env file ignored by Git.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=fuel_station_db
DATABASE_USER=replace_with_database_user
DATABASE_PASSWORD=replace_with_database_password

# Generate a unique secret of at least 32 characters. Never commit the real value.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRE_MINUTES=480

# Used once by create_initial_owner.py. Do not commit real values.
INITIAL_OWNER_USERNAME=replace_with_initial_owner_username
INITIAL_OWNER_NAME=replace_with_initial_owner_full_name
INITIAL_OWNER_EMAIL=replace_with_initial_owner_email_or_leave_blank
INITIAL_OWNER_PASSWORD=replace_with_an_initial_password_of_at_least_3_characters
